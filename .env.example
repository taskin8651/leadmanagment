APP_NAME="Lead Management CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lead_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# To send real emails, switch MAIL_MAILER=smtp and fill these in (Gmail, Mailgun, SES, etc.)
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

FILESYSTEM_DISK=local

# Google reCAPTCHA v2 (leave blank to disable — forms work without it)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# WhatsApp lead webhook (e.g. 11za) — set this, then add the same value as
# ?token=... on the webhook URL you give the provider. Field mapping in
# WhatsAppWebhookController is a placeholder until the real payload is shared.
WHATSAPP_WEBHOOK_SECRET=

# 11za WhatsApp — outbound messages sent from a lead's page ("Send WhatsApp").
# Request shape in app/Services/ElevenZaWhatsAppService.php is a placeholder
# until confirmed against 11za's API docs — update it once you have real credentials.
ELEVENZA_API_URL=
ELEVENZA_API_KEY=
ELEVENZA_SENDER_ID=

# Facebook Lead Ads webhook — see README "Facebook & Google Ads lead sync".
FACEBOOK_LEADS_VERIFY_TOKEN=
FACEBOOK_LEADS_APP_SECRET=
FACEBOOK_LEADS_PAGE_ACCESS_TOKEN=

# Google Ads lead form extension webhook — see README "Facebook & Google Ads lead sync".
GOOGLE_ADS_LEADS_WEBHOOK_SECRET=
